<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Technical Workshop Registration</title>
    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --bg: #f8fafc;
            --card-bg: #ffffff;
            --text: #1e293b;
            --text-light: #64748b;
            --border: #cbd5e1;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            line-height: 1.5;
            padding: 2rem 1rem;
            margin: 0;
        }
        .form-container {
            max-width: 600px;
            margin: 0 auto;
            background: var(--card-bg);
            padding: 2.5rem;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        .header {
            margin-bottom: 2rem;
            border-bottom: 2px solid #f1f5f9;
            padding-bottom: 1rem;
        }
        h2 { margin: 0 0 0.5rem 0; color: #0f172a; font-size: 1.75rem; }
        .subtitle { color: var(--text-light); margin: 0; font-size: 0.95rem; }
        .section-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #334155;
            margin: 1.5rem 0 1rem 0;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .form-group { margin-bottom: 1.25rem; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        label { display: block; margin-bottom: 0.5rem; font-weight: 500; font-size: 0.9rem; }
        input[type="text"], input[type="email"], input[type="tel"], select {
            width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: 6px; font-size: 0.95rem; box-sizing: border-box; transition: all 0.2s;
        }
        input:focus, select:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15); }
        button {
            width: 100%; background-color: var(--primary); color: white; border: none; padding: 0.85rem; font-size: 1rem; font-weight: 600; border-radius: 6px; cursor: pointer; transition: background-color 0.2s; margin-top: 1rem;
        }
        button:hover { background-color: var(--primary-hover); }
        footer {
            text-align: center;
            margin-top: 2.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border);
            color: var(--text-light);
            font-size: 0.9rem;
        }
        footer strong { color: var(--text); }
        @media (max-width: 480px) { .form-row { grid-template-columns: 1fr; } }
    </style>
</head>
<body>

<div class="form-container">
    <div class="header">
        <h2>Technical Workshop Registration</h2>
        <p class="subtitle">Secure your student pass for the upcoming engineering symposium.</p>
    </div>

    <form id="workshopForm" action="/api/workshop/book" method="POST">
        <div class="section-title">1. Attendee Profile</div>
        <div class="form-group">
            <label for="fullName">Full Name</label>
            <input type="text" id="fullName" name="fullName" required placeholder="e.g., John Doe">
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="email">Institutional Email</label>
                <input type="email" id="email" name="email" required placeholder="name@university.edu">
            </div>
            <div class="form-group">
                <label for="phone">Contact Number</label>
                <input type="tel" id="phone" name="phone" required placeholder="+1 (555) 000-0000">
            </div>
        </div>

        <div class="section-title">2. Academic Verification</div>
        <div class="form-group">
            <label for="college">College / University Name</label>
            <input type="text" id="college" name="college" required placeholder="Enter full institution name">
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="studentId">Student ID</label>
                <input type="text" id="studentId" name="studentId" required placeholder="e.g., STU98765">
            </div>
            <div class="form-group">
                <label for="yearOfStudy">Current Year</label>
                <select id="yearOfStudy" name="yearOfStudy" required>
                    <option value="" disabled selected>Select year</option>
                    <option value="1st">First Year</option>
                    <option value="2nd">Second Year</option>
                    <option value="3rd">Third Year</option>
                    <option value="4th">Fourth Year</option>
                </select>
            </div>
        </div>

        <div class="section-title">3. Session Preference</div>
        <div class="form-group">
            <label for="workshopTrack">Technical Track Focus</label>
            <select id="workshopTrack" name="workshopTrack" required>
                <option value="" disabled selected>Select a curriculum track</option>
                <option value="web-dev">Advanced Full-Stack Architectures</option>
                <option value="ai-ml">Applied Machine Learning & Neural Networks</option>
                <option value="cybersecurity">Enterprise Cybersecurity Infrastructure</option>
            </select>
        </div>

        <button type="submit">Generate Student Ticket</button>
    </form>

    <footer>
        <p>Submitted By: <strong>Madhur Wanjari</strong> &nbsp;|&nbsp; PRN: <strong>24070521070</strong></p>
    </footer>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const nameInput = document.getElementById("fullName");
        const emailInput = document.getElementById("email");
        const phoneInput = document.getElementById("phone");
        const collegeInput = document.getElementById("college");
        const trackSelect = document.getElementById("workshopTrack");
        const workshopForm = document.getElementById("workshopForm");

        nameInput.focus();

        if (localStorage.getItem("studentName")) nameInput.value = localStorage.getItem("studentName");
        if (localStorage.getItem("studentEmail")) emailInput.value = localStorage.getItem("studentEmail");
        if (localStorage.getItem("studentPhone")) phoneInput.value = localStorage.getItem("studentPhone");
        if (localStorage.getItem("studentCollege")) collegeInput.value = localStorage.getItem("studentCollege");

        if (sessionStorage.getItem("selectedTrack")) {
            trackSelect.value = sessionStorage.getItem("selectedTrack");
        }

        trackSelect.addEventListener("change", function() {
            sessionStorage.setItem("selectedTrack", trackSelect.value);
        });

        workshopForm.addEventListener("submit", function(event) {
            localStorage.setItem("studentName", nameInput.value);
            localStorage.setItem("studentEmail", emailInput.value);
            localStorage.setItem("studentPhone", phoneInput.value);
            localStorage.setItem("studentCollege", collegeInput.value);
            alert("Success! Registration details cached securely.");
        });
    });
</script>
</body>
</html>
