<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vehicle Registration Validator</title>
    <style>
        :root {
            --bg-color: #f4f7f6;
            --card-bg: #ffffff;
            --text-color: #333333;
            --primary-color: #4a90e2;
            --success-color: #2ecc71;
            --error-color: #e74c3c;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            position: relative;
        }

        .container {
            background-color: var(--card-bg);
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 400px;
        }

        h2 {
            margin-bottom: 20px;
            font-size: 1.5rem;
            text-align: center;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        input {
            width: 100%;
            padding: 12px;
            border: 2px solid #ccc;
            border-radius: 6px;
            font-size: 1.1rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: border-color 0.3s ease;
        }

        input:focus {
            outline: none;
            border-color: var(--primary-color);
        }

        .feedback {
            margin-top: 8px;
            font-size: 0.85rem;
            min-height: 20px;
            font-weight: 500;
        }

        .valid {
            color: var(--success-color);
        }

        .invalid {
            color: var(--error-color);
        }

        button {
            width: 100%;
            padding: 12px;
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            margin-top: 10px;
            transition: background-color 0.2s ease;
        }

        button:hover {
            background-color: #357abd;
        }

        .format-guide {
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid #eee;
            font-size: 0.8rem;
            color: #666;
            line-height: 1.6;
        }

        /* Bottom right metadata styling */
        .student-info {
            position: fixed;
            bottom: 15px;
            right: 15px;
            background-color: rgba(255, 255, 255, 0.9);
            padding: 8px 12px;
            border-radius: 4px;
            border-left: 4px solid var(--primary-color);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            font-size: 0.8rem;
            color: #555;
            text-align: right;
            line-height: 1.4;
        }
    </style>
</head>
<body>

<div class="container">
    <h2>Vehicle Validator</h2>
    
    <form id="registrationForm" onsubmit="handleSubmit(event)">
        <div class="form-group">
            <label id="inputLabel" for="plateInput">Enter Registration Number</label>
            <input 
                type="text" 
                id="plateInput" 
                placeholder="e.g., MH01AA1234" 
                maxlength="10"
                autocomplete="off"
            >
            <div id="feedbackMessage" class="feedback"></div>
        </div>
        
        <button type="submit">Submit</button>
    </form>

    <div class="format-guide">
        <strong>Required Pattern (10 Characters):</strong>
        <ul>
            <li>Chars 1-2: State Code (Letters)</li>
            <li>Chars 3-4: District Code (Digits)</li>
            <li>Chars 5-6: Sequence (Letters)</li>
            <li>Chars 7-10: Vehicle Number (Digits)</li>
        </ul>
    </div>
</div>

<!-- Added student info label in bottom right corner -->
<div class="student-info">
    <strong>Name:</strong> Madhur Wanjari<br>
    <strong>PRN:</strong> 24070521070
</div>

<script>
    const plateInput = document.getElementById('plateInput');
    const feedbackMessage = document.getElementById('feedbackMessage');

    // Simple helper: check if character is between A and Z
    function isLetter(char) {
        if (char >= 'A' && char <= 'Z') {
            return true;
        } else {
            return false;
        }
    }

    // Simple helper: check if character is between 0 and 9
    function isDigit(char) {
        if (char >= '0' && char <= '9') {
            return true;
        } else {
            return false;
        }
    }

    // Plain if-else function to check all rules by character index
    function isValidVehicleNumber(str) {
        if (str.length !== 10) {
            return false;
        }
        // Chars 1-2: Letters
        else if (!isLetter(str[0]) || !isLetter(str[1])) {
            return false;
        }
        // Chars 3-4: Digits
        else if (!isDigit(str[2]) || !isDigit(str[3])) {
            return false;
        }
        // Chars 5-6: Letters
        else if (!isLetter(str[4]) || !isLetter(str[5])) {
            return false;
        }
        // Chars 7-10: Digits
        else if (!isDigit(str[6]) || !isDigit(str[7]) || !isDigit(str[8]) || !isDigit(str[9])) {
            return false;
        }
        // If it survives all checks, it's valid!
        else {
            return true;
        }
    }

    // Live validation as user types
    plateInput.addEventListener('input', () => {
        let value = plateInput.value.toUpperCase();
        plateInput.value = value;

        if (value.length === 0) {
            clearFeedback();
            return;
        }

        if (value.length < 10) {
            showInvalid("Keep typing... Must be exactly 10 characters.");
            plateInput.style.borderColor = '#e74c3c';
        } else {
            if (isValidVehicleNumber(value) === true) {
                showValid("Format is valid!");
                plateInput.style.borderColor = '#2ecc71';
            } else {
                showInvalid("Invalid format. Follow the guide below.");
                plateInput.style.borderColor = '#e74c3c';
            }
        }
    });

    function showValid(msg) {
        feedbackMessage.textContent = msg;
        feedbackMessage.className = "feedback valid";
    }

    function showInvalid(msg) {
        feedbackMessage.textContent = msg;
        feedbackMessage.className = "feedback invalid";
    }

    function clearFeedback() {
        feedbackMessage.textContent = "";
        feedbackMessage.className = "feedback";
        plateInput.style.borderColor = '#ccc';
    }

    // Form submission verification
    function handleSubmit(event) {
        event.preventDefault();
        const value = plateInput.value;

        if (isValidVehicleNumber(value) === true) {
            alert(`Success! "${value}" registered.`);
        } else {
            alert("Submission failed. Please fix form errors.");
        }
    }
</script>

</body>
</html>
