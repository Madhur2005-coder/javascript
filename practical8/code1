<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gym Admission</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: #f1f2f6;
            font-family: Arial, Helvetica, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #24364b;
        }

        .container {
            width: 492px;
            background: #ffffff;
            padding: 34px 30px 28px;
            border-radius: 12px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        }

        h1 {
            margin: 0 0 27px;
            text-align: center;
            font-size: 25px;
            font-weight: 700;
            letter-spacing: 0.3px;
            color: #26394e;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 7px;
            font-size: 14px;
            font-weight: 700;
            color: #24364b;
        }

        input,
        select {
            width: 100%;
            height: 47px;
            padding: 0 13px;
            border: 2px solid #d2dbe5;
            border-radius: 6px;
            background: #fff;
            font-size: 14px;
            color: #26394e;
            outline: none;
            transition: 0.2s;
        }

        input::placeholder {
            color: #8792a0;
        }

        input:focus,
        select:focus {
            border-color: #8db5e8;
        }

        /* Email error state */
        .email-error input {
            border-color: #ff4052;
            background: #e9f0ff;
        }

        .error-message {
            margin-top: 7px;
            font-size: 12px;
            color: #ff4052;
        }

        /* Green select border shown in screenshot */
        select {
            border-color: #18d86d;
            cursor: pointer;
            appearance: auto;
        }

        .submit-btn {
            width: 100%;
            height: 49px;
            margin-top: 9px;
            border: none;
            border-radius: 6px;
            background: #ff4658;
            color: white;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
        }

        .submit-btn:hover {
            background: #f4384b;
        }

        .footer {
            margin-top: 24px;
            padding-top: 16px;
            border-top: 1px dashed #d8dfe7;
            text-align: center;
        }

        .footer-name {
            font-size: 14px;
            font-weight: 500;
            color: #34475c;
            margin-bottom: 4px;
        }

        .footer-prn {
            font-size: 12px;
            color: #9aa9ba;
        }

        @media (max-width: 550px) {
            body {
                padding: 20px;
                align-items: center;
            }

            .container {
                width: 100%;
                padding: 30px 22px 25px;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>GYM ADMISSION</h1>

        <form>

            <!-- Full Name -->
            <div class="form-group">
                <label for="name">Full Name</label>
                <input
                    type="text"
                    id="name"
                    placeholder="John Doe"
                >
            </div>

            <!-- Email -->
            <div class="form-group email-error">
                <label for="email">Email Address</label>
                <input
                    type="text"
                    id="email"
                    value="25070521261"
                >
                <div class="error-message">
                    Please enter a valid email address.
                </div>
            </div>

            <!-- Age -->
            <div class="form-group">
                <label for="age">Age (Must be 16+)</label>
                <input
                    type="number"
                    id="age"
                    value="25"
                    min="16"
                >
            </div>

            <!-- Membership -->
            <div class="form-group">
                <label for="membership">Membership Plan</label>
                <select id="membership">
                    <option>Monthly Tier (₹1,500/mo)</option>
                    <option>Quarterly Tier (₹4,000/3mo)</option>
                    <option>Yearly Tier (₹15,000/year)</option>
                </select>
            </div>

            <!-- Submit -->
            <button type="submit" class="submit-btn">
                SUBMIT APPLICATION
            </button>

        </form>

        <!-- Footer -->
        <div class="footer">
            <div class="footer-name">Madhur Wanjari</div>
            <div class="footer-prn">PRN: 24070521070</div>
        </div>

    </div>

</body>
</html>
